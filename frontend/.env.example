# Copy to .env.local and adjust. Vite embeds VITE_* values at build time,
# so restart `npm run dev` (or rebuild) after changing them.

# Base URL of the IntelliClaim API, INCLUDING the /api prefix: request paths
# such as /claims are appended to it. Defaults to http://localhost:8000/api.
VITE_API_URL=http://localhost:8000/api

# Production example (set this in the Vercel project's environment variables):
# VITE_API_URL=https://your-backend.up.railway.app/api
