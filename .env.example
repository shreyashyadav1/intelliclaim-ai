# IntelliClaim AI backend settings (see backend/config.py).
# Local development: copy to backend/.env. Docker Compose: copy to ./.env.
# Real environment variables take precedence over values in these files.

# --- AI providers: extraction and RAG answers need one of them ---
GROQ_API_KEY=
# Groq retires models over time: https://console.groq.com/docs/deprecations
GROQ_MODEL=openai/gpt-oss-120b
# low, medium or high for reasoning models such as gpt-oss; empty for models without reasoning.
GROQ_REASONING_EFFORT=low
# Optional. When set, OpenAI is tried first and Groq is the fallback.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
LLM_TIMEOUT_SECONDS=20
LLM_MAX_RETRIES=1
# true = no provider calls; AI endpoints return labelled mock output ("source": "mock").
# false (default) = AI endpoints return 503 when no provider is configured.
MOCK_LLM=false
# Longer documents are truncated (and a warning is logged) before extraction.
EXTRACTION_MAX_INPUT_CHARS=4000

# --- MongoDB ---
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=intelliclaim

# --- File storage and uploads (relative paths resolve against the working directory) ---
LOCAL_STORAGE_PATH=./uploads
MAX_UPLOAD_MB=50
# PDF pages or TIFF frames per upload
MAX_DOCUMENT_PAGES=50

# --- Vector search ---
CHROMA_PERSIST_DIR=./chroma_data
# Where fastembed keeps BAAI/bge-small-en-v1.5. Empty = fastembed's default
# (a temp directory, so the model is downloaded again after every restart).
FASTEMBED_CACHE_PATH=

# --- API protection ---
# When set, DELETE /api/documents/{id}, DELETE /api/claims/{id},
# POST /api/rag/index-all and GET /api/health/groq need an X-Admin-Key header.
ADMIN_API_KEY=
RATE_LIMIT_ENABLED=true
# Proxies in front of the API (Railway: 1). Use 0 when clients connect directly,
# otherwise they could pick their own rate-limit key via X-Forwarded-For.
TRUSTED_PROXY_COUNT=1

# --- CORS: comma-separated list or JSON array ---
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
